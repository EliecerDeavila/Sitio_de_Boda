---
import BaseHead from "../components/BaseHead.astro";
const { title, description, image = "/images/logo.png" } = Astro.props;
---

<html lang="es" style="scroll-behavior: smooth; scroll-padding-top: 100px;">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="text-gray-800 antialiased">
    <header id="main-header" class="relative z-50 w-full bg-boda-arena/40 backdrop-blur-md shadow-sm transition-all duration-500">
      <nav class="max-w-4xl mx-auto px-6 py-4">
        <div class="flex justify-between items-center relative">
          
          <a href="#inicio" class="z-50">
            <img src="/images/logo.png" class="h-10 md:h-12 w-auto object-contain" alt="Logo Boda">
          </a>

          <button id="menu-button" class="md:hidden text-boda-verde-oscuro p-2 focus:outline-none z-50" aria-label="Abrir menú">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
          </button>

          <ul id="menu-links" class="hidden absolute top-full left-0 w-full bg-white/95 backdrop-blur-md p-10 flex-col items-center gap-8 shadow-xl z-40 md:static md:flex md:flex-row md:bg-transparent md:backdrop-blur-none md:p-0 md:shadow-none md:justify-end md:w-auto md:gap-2 transition-all duration-300">
            <li><a href="#inicio" class="nav-item font-serif text-gray-600 transition-all duration-300 hover:text-boda-verde-dark text-lg md:text-base px-3 py-1 rounded-full" data-target="inicio">Inicio</a></li>
            <li><a href="#itinerario" class="nav-item font-serif text-gray-600 transition-all duration-300 hover:text-boda-verde-dark text-lg md:text-base px-3 py-1 rounded-full" data-target="itinerario">Itinerario</a></li>
            <li><a href="#galeria" class="nav-item font-serif text-gray-600 transition-all duration-300 hover:text-boda-verde-dark text-lg md:text-base px-3 py-1 rounded-full" data-target="galeria">Galería</a></li>
            <li><a href="#lugar" class="nav-item font-serif text-gray-600 transition-all duration-300 hover:text-boda-verde-dark text-lg md:text-base px-3 py-1 rounded-full" data-target="lugar">Lugar</a></li>
            <li><a href="#confirmacion" class="nav-item font-serif text-gray-600 transition-all duration-300 hover:text-boda-verde-dark text-lg md:text-base px-3 py-1 rounded-full" data-target="confirmacion">Confirmación</a></li>
          </ul>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-boda-arena/40 py-16 px-6 border-t border-boda-verde/10">
      <div class="max-w-4xl mx-auto text-center">
        <img src="/images/logo.png" class="h-20 w-auto mx-auto mb-8 object-contain" alt="Logo">
        <h3 class="font-serif text-3xl text-gray-800 mb-4 italic">Orlando Medrano & Daniela Zambrano</h3>
        <p class="font-sans text-sm tracking-widest text-gray-500 uppercase mb-8">— 11.07.2026 —</p>
        <p class="font-sans text-[10px] text-gray-400 uppercase tracking-widest">Hecho con ♡ para nuestra familia y amigos</p>
      </div>
    </footer>

    <style is:global>
      .active-link {
        color: #fff !important;
        font-weight: bold;
        transform: scale(1.1);
      }
      .show-menu { display: flex !important; }
      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 1s ease-out;
      }
      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      .menu-active {
        background-color: #8BA68D !important; /* boda-verde */
        color: white !important;
        font-weight: bold;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        border-radius: 9999px;
      }
    </style>

    <script>
      function init() {
        const header = document.getElementById('main-header');
        const menuButton = document.getElementById('menu-button');
        const menuLinks = document.getElementById('menu-links');
        const menuIcon = document.getElementById('menu-icon');
        const navItems = document.querySelectorAll('.nav-item');

        // Íconos SVG
        const iconMenu = "M4 6h16M4 12h16m-7 6h7";
        const iconClose = "M6 18L18 6M6 6l12 12";

        function toggleMenu() {
          const isOpened = menuLinks?.classList.contains('show-menu');
          
          if (isOpened) {
            menuLinks?.classList.remove('show-menu');
            menuIcon?.setAttribute('d', iconMenu);
          } else {
            menuLinks?.classList.add('show-menu');
            menuIcon?.setAttribute('d', iconClose);
          }
        }

        // Evento click botón
        menuButton?.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMenu();
        });

        // Cerrar al clickear un link
        navItems.forEach(item => {
          item.addEventListener('click', () => {
            menuLinks?.classList.remove('show-menu');
            menuIcon?.setAttribute('d', iconMenu);
          });
        });

        // Observer para animaciones
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('active');
            else entry.target.classList.remove('active');
          });
        }, { threshold: 0.1, rootMargin: "-50px 0px" });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Lógica para resaltar menú activo (Scroll Spy)
        const navLinks = document.querySelectorAll('.nav-item');
        const sections = [];

        navLinks.forEach(link => {
          const targetId = link.getAttribute('data-target');
          const section = document.getElementById(targetId);
          if (section) sections.push({ id: targetId, el: section, link: link });
        });

        function updateMenu() {
          // Por defecto, inicio activo
          let currentId = sections.length > 0 ? sections[0].id : null;

          // Encontrar la sección más alta que esté visible (offset de 150px)
          for (let i = sections.length - 1; i >= 0; i--) {
            if (window.scrollY + 150 >= sections[i].el.offsetTop) {
              currentId = sections[i].id;
              break;
            }
          }

          // Actualizar clases
          navLinks.forEach(link => link.classList.remove('menu-active'));
          
          const activeLink = document.querySelector(`.nav-item[data-target="${currentId}"]`);
          if (activeLink) activeLink.classList.add('menu-active');
        }

        window.addEventListener('scroll', updateMenu);
        updateMenu(); // Ejecutar al inicio

        // Lógica de Scroll
        window.addEventListener('scroll', () => {
          if (window.scrollY > 50) {
            header?.classList.add('fixed', 'top-0', 'bg-boda-arena/80');
            header?.classList.remove('relative', 'bg-boda-arena/40');
          } else {
            header?.classList.add('relative', 'bg-boda-arena/40');
            header?.classList.remove('fixed', 'top-0', 'bg-boda-arena/80');
          }
        });
      }

      document.addEventListener('astro:page-load', init);
      init();
    </script>
  </body>
</html>