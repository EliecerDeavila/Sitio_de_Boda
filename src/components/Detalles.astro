---
import { MapPin, Shirt } from '@lucide/astro';
---

<section id="lugar" class="py-16 bg-boda-arena/10 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
      
      <div class="reveal bg-white p-8 md:p-12 rounded-[3rem] shadow-sm flex flex-col items-center text-center border border-boda-arena/20 transition-all duration-500 hover:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.15)]">
        <div class="mb-6 w-14 h-14 rounded-full bg-boda-verde/5 flex items-center justify-center">
          <MapPin size={28} stroke-width={1.2} class="text-boda-verde" />
        </div>
        
        <div class="mb-6">
          <h3 class="font-serif text-3xl text-gray-800 mb-2 italic">La Ceremonia</h3>
          <p class="font-sans text-gray-600 mb-1 uppercase tracking-[0.3em] text-[9px] font-bold">Cartagena de Indias</p>
          <p class="font-serif italic text-gray-400 text-xs mb-6">"El lugar mágico donde diremos 'Sí, acepto'"</p>
        </div>

        <div class="w-full h-48 rounded-[2rem] overflow-hidden border border-boda-arena/30 mb-6 shadow-inner">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3924.349278788153!2d-75.48529592591767!3d10.39380868973264!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8ef625cb11285afd%3A0x1fe51d7f8f96e26!2sSalon%20De%20Eventos%20Los%20Veleros!5e0!3m2!1ses!2sco!4v1777083474738!5m2!1ses!2sco" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="grayscale-[0.2] contrast-[0.9] hover:grayscale-0 transition-all duration-700"
          ></iframe>
        </div>
        
        <a 
          href="https://maps.app.goo.gl/ncvh1tVRAKpQ64pRA" 
          target="_blank" 
          class="inline-block border border-boda-verde/30 text-boda-verde hover:bg-boda-verde hover:text-white px-8 py-3 rounded-full font-sans text-[9px] uppercase tracking-[0.2em] transition-all duration-300 font-bold"
        >
          Abrir en Google Maps
        </a>
      </div>

      <div class="reveal bg-white p-8 md:p-12 rounded-[3rem] shadow-sm flex flex-col items-center text-center border border-boda-arena/20 transition-all duration-500 hover:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.15)]">
        <div class="mb-6 w-14 h-14 rounded-full bg-boda-verde/5 flex items-center justify-center">
          <Shirt size={28} stroke-width={1.2} class="text-boda-verde" />
        </div>

        <h3 class="font-serif text-3xl text-gray-800 mb-1 italic">Dress Code</h3>
        <p class="font-sans text-boda-verde font-bold uppercase tracking-[0.3em] text-[9px] mb-8">Formal / Gala</p>
        
        <div class="w-full space-y-8 mb-10">
          <div class="flex flex-col items-center">
            <p class="font-serif italic text-lg text-gray-800">Mujeres</p>
            <p class="font-sans text-[12px] text-gray-600 mb-2 leading-relaxed">Vestido largo formal <br> <span class="text-[10px] text-gray-400 uppercase tracking-tighter">(Unicolor, sin estampados)</span></p>
            <a href="https://pin.it/29f5ZANdq" target="_blank" class="text-[9px] uppercase tracking-widest text-boda-verde-oscuro border-b border-boda-arena pb-1 hover:text-boda-verde hover:border-boda-verde transition-all">Ver inspiración mujeres</a>
          </div>
          
          <div class="flex flex-col items-center">
            <p class="font-serif italic text-lg text-gray-800">Hombres</p>
            <p class="font-sans text-[12px] text-gray-600 mb-2 leading-relaxed">Traje de lino o Guayabera <br> <span class="text-[10px] text-gray-400 uppercase tracking-tighter">(Manga larga)</span></p>
            <a href="https://pin.it/2K0tDWYqm" target="_blank" class="text-[9px] uppercase tracking-widest text-boda-verde-oscuro border-b border-boda-arena pb-1 hover:text-boda-verde hover:border-boda-verde transition-all"> Ver inspiración hombres</a>
          </div>
        </div>

        <div class="pt-6 border-t border-gray-50 w-full flex flex-col items-center">
          <p class="font-sans text-[9px] text-gray-400 uppercase tracking-[0.2em] font-bold mb-4 italic">Colores reservados:</p>
          <div class="flex gap-6">
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-7 h-7 rounded-full bg-white border border-gray-200 shadow-sm"></div>
              <span class="text-[8px] text-gray-400 uppercase tracking-tighter">Blanco</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-7 h-7 rounded-full bg-[#556B2F] shadow-sm border border-black/5"></div>
              <span class="text-[8px] text-gray-400 uppercase tracking-tighter font-bold">Verde Oliva</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-7 h-7 rounded-full bg-[#F5F5DC] shadow-sm border border-black/5"></div>
              <span class="text-[8px] text-gray-400 uppercase tracking-tighter font-bold">Beige</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>