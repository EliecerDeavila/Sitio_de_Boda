---
import audio from "../assets/audio/PerfectInstrumental.mp3";
import { Image } from "astro:assets";
import flores from "../assets/flores/flor5.png";
---

<div id="splash-screen" class="fixed inset-0 z-[9999] bg-white flex flex-col items-center justify-center overflow-hidden">
    <audio id="audio-player" src={audio} preload="auto"></audio>

    <!-- Decoración Superior Derecha -->
    <div class="absolute top-0 right-0 pointer-events-none z-10 splash-flower-top opacity-0" style="animation: aparecer-esquina 1.2s ease-out 0.2s forwards;">
        <div class="rotate-[225deg]">
            <Image src={flores} alt="Flor decorativa superior" class="w-[150px] lg:w-[280px] 2xl:w-[400px] h-auto object-contain opacity-70" />
        </div>
    </div>

    <div class="relative z-20 text-center px-8 pt-40 lg:pt-24 2xl:pt-0">
        <div id="splash-loader" class="mb-8 flex justify-center">
            <div class="loader-ring"></div>
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-boda-verde splash-icon opacity-0" style="animation: aparecer 0.8s ease-out 0.5s forwards;">
                <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path>
            </svg>
        </div>

        <p class="font-sans text-[11px] uppercase tracking-[0.4em] text-boda-verde/70 mb-4 font-semibold splash-text opacity-0" style="animation: aparecer-subir 1s ease-out 1s forwards;">
            Estás invitado
        </p>

        <h1 class="font-serif text-5xl md:text-6xl text-gray-800 mb-3 italic splash-text opacity-0" style="animation: aparecer 1s ease-out 1.3s forwards;">
            Orlando <span class="text-boda-verde">&</span> Daniela
        </h1>

        <div class="w-16 h-[1px] bg-boda-arena mx-auto my-6 splash-text opacity-0" style="animation: brillar 2s ease-in-out 1.6s forwards;"></div>

        <p class="font-serif italic text-gray-400 text-sm mb-10 splash-text opacity-0" style="animation: aparecer-subir 1s ease-out 1.9s forwards;">
            11 de Julio de 2026 • Cartagena, Colombia
        </p>

        <div class="splash-text opacity-0" style="animation: aparecer-subir 1s ease-out 2.2s forwards;">
            <button id="open-invitation" 
                    class="inline-flex items-center gap-2 bg-boda-verde text-white font-sans text-[11px] uppercase tracking-[0.3em] font-semibold px-12 py-4 rounded-full shadow-lg hover:bg-boda-verde-dark hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Abrir Invitación
            </button>
        </div>

        <p class="font-sans text-[10px] text-gray-400 mt-6 tracking-wider splash-text opacity-0" style="animation: flotar-suave 4s ease-in-out 2.5s infinite forwards;">
            Con música para ambientar este día especial
        </p>
    </div>

    <!-- Decoración Inferior Izquierda -->
    <div class="absolute bottom-0 left-0 pointer-events-none z-10 splash-flower-bottom opacity-0" style="animation: aparecer-esquina-inv 1.2s ease-out 0.4s forwards;">
        <div class="rotate-45 -translate-x-12 translate-y-12">
            <Image src={flores} alt="Flor decorativa inferior" class="w-[150px] lg:w-[280px] 2xl:w-[400px] h-auto object-contain opacity-70" />
        </div>
    </div>
    </div>
</div>

<style>
    @keyframes aparecer {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes aparecer-subir {
        0% { opacity: 0; transform: translateY(30px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    @keyframes brillar {
        0%, 100% { box-shadow: 0 0 5px rgba(139, 166, 141, 0.2); }
        50% { box-shadow: 0 0 20px rgba(139, 166, 141, 0.6); }
    }

    @keyframes flotar-suave {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    @keyframes aparecer-esquina {
        from { opacity: 0; transform: translate(40px, -40px); }
        to { opacity: 1; transform: translate(0, 0); }
    }

    @keyframes aparecer-esquina-inv {
        from { opacity: 0; transform: translate(-40px, 40px); }
        to { opacity: 1; transform: translate(0, 0); }
    }

    #splash-loader {
        transition: opacity 0.5s ease-out;
    }
    #splash-loader.loaded {
        opacity: 0;
    }

    .loader-ring {
        width: 60px;
        height: 60px;
        border: 2px solid transparent;
        border-top-color: #8BA68D;
        border-right-color: #8BA68D;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    #splash-screen.closing {
        opacity: 0;
        pointer-events: none;
        transition: opacity 1.5s ease-in-out;
    }

    #splash-loader {
        transition: opacity 0.5s ease-out;
    }
    #splash-loader.loaded {
        opacity: 0;
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const splashScreen = document.getElementById("splash-screen");
        const openBtn = document.getElementById("open-invitation");
        const mainAudio = document.getElementById("audio-player");
        const splashLoader = document.getElementById("splash-loader");

        setTimeout(() => {
            splashLoader.classList.add("loaded");
        }, 1200);

        openBtn.addEventListener("click", () => {
            if (mainAudio) {
                mainAudio.volume = 0.5;
                mainAudio.loop = true;
                mainAudio.play().then(() => {
                    document.body.appendChild(mainAudio);
                }).catch(() => {});
            }

            splashScreen.classList.add("closing");

            setTimeout(() => {
                splashScreen.remove();
                document.body.style.overflow = "auto";
                
                const inicio = document.getElementById("inicio");
                if (inicio) {
                    inicio.scrollIntoView({ behavior: "smooth" });
                }
            }, 1500);
        });

        document.body.style.overflow = "hidden";
    });
</script>
