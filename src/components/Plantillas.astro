---
import { Image, Download, Link } from "@lucide/astro";

const templates = [
    {
        nombre: "Plantilla 1",
        imagen: "/plantillas/Plantilla-1.png",
    },
    {
        nombre: "Plantilla 2",
        imagen: "/plantillas/Plantilla-2.png",
    },
];

const driveUrl = "https://drive.google.com/drive/folders/1fi_wtxNjjjPyf4ET3Qe-aiw7yU_zAyzA?usp=drive_link";
---

<section id="plantillas" class="py-16 bg-boda-arena/10 overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 text-center">
        
        <div class="mb-8 flex justify-center text-boda-verde" style="animation: var(--animate-flotar);">
            <Image size={40} />
        </div>

        <h2 class="font-serif text-4xl text-gray-800 mb-4 italic">
            Marcos para tus Fotos
        </h2>
        
        <p class="font-sans text-gray-600 leading-relaxed mb-12 tracking-wide max-w-xl mx-auto">
            Descarga nuestros marcos exclusivos y úsalos en las fotos que tomes durante la celebración. 
            ¡Comparte tus momentos con <span class="text-boda-verde font-semibold">#UNSIPARASIEMPREO&D</span>!
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-12">
            {templates.map((template) => (
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-boda-arena/20 flex flex-col items-center">
                    <div class="w-full aspect-square max-w-[280px] rounded-2xl overflow-hidden mb-6 border border-boda-arena/10 bg-gray-50">
                        <img 
                            src={template.imagen} 
                            alt={template.nombre} 
                            class="w-full h-full object-contain"
                        />
                    </div>

                    <h3 class="font-serif text-xl text-gray-800 mb-4 italic">
                        {template.nombre}
                    </h3>

                    <a 
                        href={template.imagen} 
                        download 
                        class="inline-flex items-center gap-2 bg-boda-verde text-white font-sans text-[10px] uppercase tracking-[0.25em] font-semibold px-6 py-3 rounded-full shadow-sm hover:bg-boda-verde-dark hover:shadow-md transition-all duration-300 cursor-pointer w-full justify-center"
                    >
                        <Download size={16} />
                        Descargar
                    </a>
                </div>
            ))}
        </div>

        <!-- Sección Drive para invitados -->
        <div class="bg-white rounded-3xl p-10 shadow-sm border border-boda-arena/20 max-w-lg mx-auto mb-16">
            <div class="flex justify-center mb-4 text-boda-verde">
                <Link size={32} />
            </div>
            <h3 class="font-serif text-2xl text-gray-800 mb-3 italic">¡Comparte tus Fotos con Nosotros!</h3>
            <p class="font-sans text-sm text-gray-600 leading-relaxed mb-6">
                ¿Tomaste fotos increíbles durante la celebración? 
                Súbelas a nuestra carpeta compartida para que todos podamos revivir esos momentos especiales.
            </p>
            <a 
                href={driveUrl}
                target="_blank"
                class="inline-flex items-center gap-2 bg-boda-verde text-white font-sans text-[10px] uppercase tracking-[0.25em] font-semibold px-8 py-3 rounded-full shadow-sm hover:bg-boda-verde-dark hover:shadow-md transition-all duration-300 cursor-pointer"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                Subir Fotos
            </a>
        </div>

        <div class="flex items-center justify-center gap-4">
            <div class="w-12 h-[1px] bg-boda-arena"></div>
            <span class="text-boda-arena text-sm">✦</span>
            <div class="w-12 h-[1px] bg-boda-arena"></div>
        </div>
    </div>
</section>
