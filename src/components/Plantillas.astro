---
import { Image, Download, QrCode } from "@lucide/astro";

const templates = [
    {
        nombre: "Plantilla 1",
        imagen: "/plantillas/Plantilla-1.png",
    },
    {
        nombre: "Plantilla 2",
        imagen: "/plantillas/Plantilla-2.png",
    },
];
---

<section id="plantillas" class="py-20 bg-boda-arena/10 overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 text-center">
        
        <div class="mb-8 flex justify-center text-boda-verde" style="animation: var(--animate-flotar);">
            <Image size={40} />
        </div>

        <h2 class="font-serif text-4xl text-gray-800 mb-4 italic">
            Marcos para tus Fotos
        </h2>
        
        <p class="font-sans text-gray-600 leading-relaxed mb-12 tracking-wide max-w-xl mx-auto">
            Descarga nuestros marcos exclusivos y úsalos en las fotos que tomes durante la celebración. 
            ¡Comparte tus momentos con <span class="text-boda-verde font-semibold">#BodaOrlandoYDaniela</span>!
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-16">
            {templates.map((template) => (
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-boda-arena/20 flex flex-col items-center">
                    
                    <div class="w-full aspect-square max-w-[280px] rounded-2xl overflow-hidden mb-6 border border-boda-arena/10 bg-gray-50">
                        <img 
                            src={template.imagen} 
                            alt={template.nombre} 
                            class="w-full h-full object-contain"
                        />
                    </div>

                    <h3 class="font-serif text-xl text-gray-800 mb-4 italic">
                        {template.nombre}
                    </h3>

                    <div class="flex flex-col items-center gap-3 w-full">
                        <a 
                            href={template.imagen} 
                            download 
                            class="inline-flex items-center gap-2 bg-boda-verde text-white font-sans text-[10px] uppercase tracking-[0.25em] font-semibold px-6 py-3 rounded-full shadow-sm hover:bg-boda-verde-dark hover:shadow-md transition-all duration-300 cursor-pointer w-full justify-center"
                        >
                            <Download size={16} />
                            Descargar
                        </a>

                        <div class="mt-2 flex flex-col items-center w-full">
                            <div class="flex items-center justify-center gap-2 text-boda-verde-oscuro font-sans text-[10px] uppercase tracking-[0.2em] mb-3">
                                <QrCode size={14} />
                                Código QR para compartir
                            </div>
                            <div class="bg-white p-3 rounded-xl border border-boda-arena/20 shadow-sm inline-block">
                                <img 
                                    class="qr-image w-[150px] h-[150px]"
                                    data-path={template.imagen}
                                    alt={`QR para ${template.nombre}`}
                                    loading="lazy"
                                />
                            </div>
                            <p class="font-sans text-[9px] text-gray-400 mt-2 uppercase tracking-widest">
                                Escanea para descargar la plantilla
                            </p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <div class="flex items-center justify-center gap-4">
            <div class="w-12 h-[1px] bg-boda-arena"></div>
            <span class="text-boda-arena text-sm">✦</span>
            <div class="w-12 h-[1px] bg-boda-arena"></div>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll(".qr-image").forEach((img) => {
        const path = img.getAttribute("data-path");
        const fullUrl = `${window.location.origin}${path}`;
        img.src = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(fullUrl)}&color=8BA68D&bgcolor=FFFFFF`;
    });
</script>
