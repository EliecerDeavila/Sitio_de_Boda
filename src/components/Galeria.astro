---
import { Image } from "astro:assets";
import { Camera } from "@lucide/astro";
import img3 from "../assets/galeria/O&D_44.JPG";
import img4 from "../assets/galeria/O&D_103.JPG";
import img5 from "../assets/galeria/O&D_108.JPG";
import img6 from "../assets/galeria/O&D_187.JPG";
import img7 from "../assets/galeria/O&D_16.JPG";
import img8 from "../assets/galeria/O&D_155.JPG";
---

<section
    id="galeria"
    class="py-20 bg-white reveal transition-all duration-700 ease-out"
>
    <div class="mb-8 flex justify-center text-boda-verde" style="animation: var(--animate-flotar);">
        <Camera size={40} />
    </div>
    <div class="max-w-4xl mx-auto px-6 text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-2 animate-fade-in">
            <h2 class="font-serif text-4xl text-gray-800 italic">
                Nuestros Momentos
            </h2>
        </div>
        <div class="w-16 h-[1px] bg-boda-arena mx-auto mt-4 transition-all duration-300"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-8 gap-5 w-full max-w-6xl mx-auto px-6 py-10">
        <div class="md:row-span-2 md:col-start-1 md:col-start-3 md:row-start-1 overflow-hidden rounded-2xl md:max-h-[250px] shadow-md border-2 border-white/40 cursor-pointer transition-all duration-300 hover:scale-[1.02] lightbox-trigger">
            <Image src={img3} alt="Foto O&D 3" class="w-full h-64 md:h-full object-cover" />
        </div>

        <div class="md:row-span-2 md:col-start-1 md:col-start-3 md:row-start-3 overflow-hidden rounded-2xl md:max-h-[250px] shadow-md border-2 border-white/40 cursor-pointer transition-all duration-300 hover:scale-[1.02] lightbox-trigger">
            <Image src={img4} alt="Foto O&D 4" class="w-full h-64 md:h-full object-cover" />
        </div>

        <div class="md:row-span-2 md:col-start-1 md:col-start-3 md:row-start-5 overflow-hidden rounded-2xl md:max-h-[250px] shadow-md border-2 border-white/40 cursor-pointer transition-all duration-300 hover:scale-[1.02] lightbox-trigger">
            <Image src={img5} alt="Foto O&D 5" class="w-full h-64 md:h-full object-cover" />
        </div>

        <div class="md:col-span-2 md:row-span-5 md:col-start-1 md:row-start-1 overflow-hidden rounded-2xl md:max-h-[650px] shadow-md border-2 border-white/40 cursor-pointer transition-all duration-300 hover:scale-[1.01] lightbox-trigger">
            <Image src={img6} alt="Foto O&D 6" class="w-full h-96 md:h-full object-cover object-top" />
        </div>

        <div class="md:row-span-2 md:col-start-1 md:col-start-3 md:row-start-7 overflow-hidden rounded-2xl md:max-h-[250px] shadow-md border-2 border-white/40 cursor-pointer transition-all duration-300 hover:scale-[1.02] lightbox-trigger">
            <Image src={img8} alt="Foto O&D 7" class="w-full h-64 md:h-full object-cover object-center" />
        </div>

        <div class="md:col-span-2 md:row-span-3 md:col-start-1 md:row-start-6 overflow-hidden rounded-2xl md:max-h-[380px] shadow-md border-2 border-white/40 cursor-pointer transition-all duration-300 hover:scale-[1.01] lightbox-trigger">
            <Image src={img7} alt="Foto O&D 8" class="w-full h-96 md:h-full object-cover object-center" />
        </div>
    </div>
</section>

<div
    id="lightbox"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 p-4"
>
    <button
        id="lightbox-close"
        class="absolute top-6 right-6 text-white text-4xl hover:text-boda-arena transition-colors duration-200 z-20"
    >
        &times;
    </button>

    <button
        id="lightbox-prev"
        class="absolute left-6 text-white/70 hover:text-boda-arena text-4xl p-2 z-20 transition-all duration-200 hover:-translate-x-1"
    >
        &#8249;
    </button>

    <div class="max-w-4xl max-h-[90vh] w-full flex items-center justify-center relative select-none">
        <img
            id="lightbox-img"
            src=""
            alt="Imagen ampliada"
            class="max-w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl border-2 border-white/20 transform scale-95 transition-all duration-300"
        />
    </div>

    <button
        id="lightbox-next"
        class="absolute right-6 text-white/70 hover:text-boda-arena text-4xl p-2 z-20 transition-all duration-200 hover:translate-x-1"
    >
        &#8250;
    </button>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const triggers = document.querySelectorAll(".lightbox-trigger");
        const lightbox = document.getElementById("lightbox");
        const lightboxImg = document.getElementById("lightbox-img");
        const closeBtn = document.getElementById("lightbox-close");
        const prevBtn = document.getElementById("lightbox-prev");
        const nextBtn = document.getElementById("lightbox-next");

        const imagesSrc = [];
        const imagesAlt = [];

        triggers.forEach((trigger) => {
            const img = trigger.querySelector("img");
            if (img) {
                imagesSrc.push(img.src);
                imagesAlt.push(img.alt);
            }
        });

        let currentIndex = 0;

        const showImage = (index) => {
            lightboxImg.src = imagesSrc[index];
            lightboxImg.alt = imagesAlt[index];
        };

        triggers.forEach((trigger, index) => {
            trigger.addEventListener("click", () => {
                currentIndex = index;
                showImage(currentIndex);

                lightbox.classList.remove("opacity-0", "pointer-events-none");
                lightbox.classList.add("opacity-100");

                setTimeout(() => {
                    lightboxImg.classList.remove("scale-95");
                    lightboxImg.classList.add("scale-100");
                }, 50);
            });
        });

        const closeModal = () => {
            lightboxImg.classList.remove("scale-100");
            lightboxImg.classList.add("scale-95");
            lightbox.classList.add("opacity-0");
            lightbox.classList.remove("opacity-100");
            setTimeout(() => {
                lightbox.classList.add("pointer-events-none");
            }, 300);
        };

        prevBtn.addEventListener("click", () => {
            currentIndex = (currentIndex - 1 + imagesSrc.length) % imagesSrc.length;
            showImage(currentIndex);
        });

        nextBtn.addEventListener("click", () => {
            currentIndex = (currentIndex + 1) % imagesSrc.length;
            showImage(currentIndex);
        });

        closeBtn.addEventListener("click", closeModal);

        lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) {
                closeModal();
            }
        });
    });
</script>
