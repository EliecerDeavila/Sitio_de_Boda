---
import { Send, Heart } from "@lucide/astro";

const urlConfirmacion = "https://tu-url-aqui.com";
---

<section id="confirmacion" class="py-24 reveal relative overflow-hidden bg-gradient-to-b from-white via-boda-arena/20 to-white">
    <div class="absolute inset-0 pointer-events-none opacity-10">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs>
                <pattern id="dots" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
                    <circle cx="1" cy="1" r="0.5" fill="currentColor" class="text-boda-verde"/>
                </pattern>
            </defs>
            <rect width="100" height="100" fill="url(#dots)"/>
        </svg>
    </div>

    <div class="relative max-w-2xl mx-auto px-6 text-center">
        <div class="mb-8">
            <Heart class="mx-auto text-boda-verde mb-6 animate-pulse-slow" size={48} />
        </div>

        <h2 class="font-serif text-4xl text-gray-800 mb-6 italic">
            Tu presencia es nuestro mejor regalo
        </h2>

        <p class="font-sans text-gray-600 leading-relaxed tracking-wide mb-4">
            Queremos compartir cada momento de este día tan especial contigo.
        </p>

        <p class="font-serif italic text-gray-400 text-xs mb-10">
            Por favor, confirma tu asistencia antes del <span class="text-boda-verde font-semibold">15 de junio de 2026</span>
        </p>

        <div class="flex flex-col items-center gap-6">
            <a href="https://docs.google.com/forms/d/e/1FAIpQLSfuUqNAF7xAIeoEUfXWXX5Vkw9SBQDWoibKgZmQUjhaZkGo3Q/viewform" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-3 bg-boda-verde text-white font-sans text-sm uppercase tracking-[0.25em] font-semibold px-10 py-4 rounded-full shadow-lg hover:bg-boda-verde-dark hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300">
                <Send size={20} />
                Confirmar Asistencia
            </a>

            <p class="font-sans text-xs text-gray-400 tracking-wider">
                Te redirigiremos al formulario de confirmación
            </p>
        </div>

        <div class="mt-16 flex items-center justify-center gap-4">
            <div class="w-12 h-[1px] bg-boda-arena/60"></div>
            <span class="text-boda-arena text-lg">✦</span>
            <div class="w-12 h-[1px] bg-boda-arena/60"></div>
        </div>
    </div>
</section>

<style>
    @keyframes pulse-slow {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(1.05); }
    }
    .animate-pulse-slow {
        animation: pulse-slow 3s ease-in-out infinite;
    }
</style>